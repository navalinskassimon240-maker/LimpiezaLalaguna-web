{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Product item for Limpieza La Laguna catalog",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the product"
        },
        "name": {
          "type": "string",
          "description": "Product name"
        },
        "category": {
          "type": "string",
          "description": "Product category"
        },
        "description": {
          "type": "string",
          "description": "Product description"
        },
        "imageUrl": {
          "type": "string",
          "description": "Image URL or data URI"
        },
        "basePrice": {
          "type": "number",
          "description": "Base price in Argentine pesos"
        },
        "unitType": {
          "type": "string",
          "description": "Unit type (litros, unidades, etc.)"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "name", "category", "basePrice"]
    },
    "Announcement": {
      "title": "Announcement",
      "description": "Promotions and announcements for the store",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the announcement"
        },
        "title": {
          "type": "string",
          "description": "Announcement title"
        },
        "description": {
          "type": "string",
          "description": "Announcement description"
        },
        "imageUrl": {
          "type": "string",
          "description": "Image URL or data URI"
        },
        "tag": {
          "type": "string",
          "description": "Tag badge text"
        },
        "tagColor": {
          "type": "string",
          "description": "CSS color classes for the tag"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "title"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Store admin and configuration settings",
      "type": "object",
      "properties": {
        "adminPin": {
          "type": "string",
          "description": "Access pin for store admin"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      }
    },
    "RestorePoint": {
      "title": "RestorePoint",
      "description": "Backup snapshot to revert products and announcements",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the restore point"
        },
        "name": {
          "type": "string",
          "description": "Friendly name of the restore point"
        },
        "note": {
          "type": "string",
          "description": "Optional notes or reason for saving the restore point"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the snapshot was created"
        },
        "productCount": {
          "type": "number",
          "description": "Total count of products saved in this point"
        },
        "announcementCount": {
          "type": "number",
          "description": "Total count of announcements saved in this point"
        }
      },
      "required": ["id", "name", "createdAt"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupons for store promotions and inaugural launch",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "description": "Coupon promotional code"
        },
        "discountType": {
          "type": "string",
          "enum": ["percentage", "fixed"],
          "description": "Type of discount"
        },
        "discountValue": {
          "type": "number",
          "description": "Discount percentage or fixed amount"
        },
        "description": {
          "type": "string",
          "description": "Description of the discount"
        },
        "minSpend": {
          "type": "number",
          "description": "Minimum spend required to use the coupon"
        },
        "appliesTo": {
          "type": "string",
          "enum": ["all", "combos"],
          "description": "Target products or categories"
        },
        "active": {
          "type": "boolean",
          "description": "Whether the coupon is enabled"
        }
      },
      "required": ["code", "discountType", "discountValue", "active"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog products readable by all visitors and editable by admin"
    },
    "/announcements/{announcementId}": {
      "schema": "Announcement",
      "description": "Store news and promos readable by all visitors and editable by admin"
    },
    "/settings/{settingId}": {
      "schema": "Settings",
      "description": "Store settings"
    },
    "/restore_points/{pointId}": {
      "schema": "RestorePoint",
      "description": "Saved restore points to roll back store changes"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Discount promo coupons readable by store customers and manageable by admin"
    }
  }
}
